{
  "name": "guardio-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Guardio - Security Guard Platform",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:web": "pnpm --filter @guardio/web dev",
    "dev:mobile": "pnpm --filter @guardio/mobile dev",
    "build:web": "pnpm --filter @guardio/web build",
    "build:mobile": "pnpm --filter @guardio/mobile build",
    "android": "pnpm --filter @guardio/mobile tauri android dev",
    "ios": "pnpm --filter @guardio/mobile tauri ios dev",
    "api:mock": "json-server mock-api/db.json --port 8080 --host 0.0.0.0",
    "dev:all": "concurrently -n \"web,mobile,api\" -c \"cyan,magenta,green\" \"pnpm dev:web\" \"pnpm dev:mobile\" \"pnpm api:mock\""
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "concurrently": "^9.2.1",
    "eslint": "^8.56.0",
    "json-server": "1.0.0-beta.5",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.14.1",
  "dependencies": {
    "@types/chart.js": "^4.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.6",
    "bip39": "^3.1.0",
    "chart.js": "^4.5.1",
    "crypto-js": "^4.2.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4"
  }
}
