{
  "name": "@bolh/contracts",
  "version": "1.0.0",
  "description": "BOLH Token smart contracts for BSC, Ethereum, Polygon, Solana, TON",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:bsc-testnet": "hardhat run scripts/deploy.ts --network bscTestnet",
    "deploy:bsc": "hardhat run scripts/deploy.ts --network bsc",
    "deploy:ethereum": "hardhat run scripts/deploy.ts --network ethereum",
    "deploy:polygon": "hardhat run scripts/deploy.ts --network polygon",
    "verify:bsc": "hardhat verify --network bsc",
    "verify:ethereum": "hardhat verify --network ethereum",
    "verify:polygon": "hardhat verify --network polygon"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "dotenv": "^16.4.0",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1"
  }
}
