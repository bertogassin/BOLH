# =========================
# BOLH central env template
# =========================
# Copy this file to .env (or split per deployment system),
# then set real values in your secret manager.
# Never commit real secrets.

# App mode
APP_ENV=development

# -------------------------
# API Gateway
# -------------------------
JWT_SECRET=change_me_strong_random_secret
ADMIN_SECRET=change_me_admin_secret
PORT=8080
DATABASE_URL=postgres://guardian:change_me_db_password@localhost:5432/guardian
REDIS_ADDR=localhost:6379
INTERNAL_SERVICE_TOKEN=change_me_internal_service_token
ESCROW_STRICT=true
STRIPE_SECRET_KEY=

# Signed requests
SIGNED_REQUEST_MODE=partial
STRICT_SIGNED_REQUESTS=false
SIGNED_REQUEST_PARTIAL_PATHS=/api/v1/auth/me/password,/api/v1/orders,/api/v1/bids,/api/v1/documents/upload,/api/v1/company/register

# Optional local E2E admin seed
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=change_me_strong_password

# -------------------------
# Client web
# -------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SIGNED_REQUESTS_ENABLED=1
NEXT_PUBLIC_SIGNED_REQUEST_MODE=partial
NEXT_PUBLIC_SIGNED_REQUEST_PARTIAL_PATHS=/api/v1/auth/me/password,/api/v1/orders,/api/v1/bids,/api/v1/documents/upload,/api/v1/company/register
NEXT_PUBLIC_APP_BUILD_ID=dev-build

# -------------------------
# Optional security/canary
# -------------------------
CANARY_TOKEN_PATH=/.well-known/guardian-security-canary-9f2a7d.txt
CANARY_ALERT_WEBHOOK=
