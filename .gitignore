# ===========================================
# BOLH — Root .gitignore
# ===========================================

# ── Dependencies ──
node_modules/
.pnpm-store/

# ── Build outputs ──
dist/
build/
target/
*.dll
*.so
*.dylib
*.wasm

# ── Tauri / Android generated ──
gen/

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Environment ──
.env
.env.local
.env.*.local
*.env

# ── Database files ──
*.db
*.sqlite
*.sqlite3

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker ──
docker-compose.override.yml

# ── Temporary / artifacts ──
tmp/
temp/
*.tmp
*.temp
Root/
architecture_report.json

# ── Test / coverage ──
coverage/
.nyc_output/
