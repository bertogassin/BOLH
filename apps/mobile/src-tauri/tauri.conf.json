{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOLH",
  "version": "2.0.0",
  "identifier": "com.bolh.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "BOLH",
        "width": 400,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "geolocation": {
      "description": "Location services for finding nearby professionals"
    },
    "notification": {
      "description": "Push notifications for order updates"
    },
    "biometric": {
      "description": "Biometric authentication for secure login"
    }
  }
}
